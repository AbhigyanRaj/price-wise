    },
    {
      "id": "wby5mjybqjmufd7h",
      "type": "text",
      "x": 100,
      "y": 630,
      "width": 203.84000000000003,
      "height": 81.25,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
