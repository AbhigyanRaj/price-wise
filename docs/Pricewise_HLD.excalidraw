      "index": "a0078",
      "text": "Every LLM call is server\nside. The browser never\nholds a key.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Every LLM call is server\nside. The browser never\nholds a key.",
