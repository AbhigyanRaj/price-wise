    {
      "id": "dg9gakzyvy40zjg0",
      "type": "text",
      "x": 100,
      "y": 2300,
      "width": 786.2400000000001,
      "height": 48.75,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
