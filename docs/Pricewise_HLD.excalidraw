      "isDeleted": false,
      "boundElements": [],
      "updated": 1789900000000,
      "link": null,
      "locked": false,
      "index": "a0239",
      "text": "Money is Decimal, never Float. A rounding error in a pricing product is not an acceptable class of bug.\nAuditLog has no foreign key to User on purpose: the actor is a historical fact, and a cascade from a deleted\nuser would take the record of what they did with it.",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Money is Decimal, never Float. A rounding error in a pricing product is not an acceptable class of bug.\nAuditLog has no foreign key to User on purpose: the actor is a historical fact, and a cascade from a deleted\nuser would take the record of what they did with it.",
      "lineHeight": 1.25
    },
