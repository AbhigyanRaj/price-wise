  {
   "id": "pgyf0semr7mh850jgj",
   "type": "text",
   "x": 72,
   "y": 2272,
   "width": 1456,
   "height": 65.0,
   "angle": 0,
   "strokeColor": "#5f3a00",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 72269,
   "version": 1,
   "versionNonce": 45291,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Failure paths (not drawn above, implemented in code):\n\u00b7 Agent timeout after 2 backoff retries \u2192 recommendation persisted with status FAILED, SSE emits recommendation_failed, UI shows a retry affordance.\n\u00b7 Mock platform returns 502 on execute \u2192 price change rolled back to currentPriceAtTime, status reverts to PENDING, failure recorded in AuditLog.\n\u00b7 Client disconnects mid-stream \u2192 orchestrator continues to completion server-side so the recommendation is never lost; the client picks it up on next query refetch.",
   "fontSize": 13,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "xom6vhwaevuz0b6cd8",
   "originalText": "Failure paths (not drawn above, implemented in code):\n\u00b7 Agent timeout after 2 backoff retries \u2192 recommendation persisted with status FAILED, SSE emits recommendation_failed, UI shows a retry affordance.\n\u00b7 Mock platform returns 502 on execute \u2192 price change rolled back to currentPriceAtTime, status reverts to PENDING, failure recorded in AuditLog.\n\u00b7 Client disconnects mid-stream \u2192 orchestrator continues to completion server-side so the recommendation is never lost; the client picks it up on next query refetch.",
   "lineHeight": 1.25,
   "baseline": 13
  },
