      "isDeleted": false,
      "boundElements": [],
      "updated": 1789900000000,
      "link": null,
      "locked": false,
      "index": "a0079",
      "text": "Order is the security model.\ncsrfGuard runs before any\nhandler, tenantScope before\nany query, errorHandler last\nso it catches everything.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Order is the security model.\ncsrfGuard runs before any\nhandler, tenantScope before\nany query, errorHandler last\nso it catches everything.",
      "lineHeight": 1.25
    },
