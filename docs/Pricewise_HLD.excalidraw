   "link": null,
   "locked": false
  },
  {
   "id": "ibgdr5x5ho1wfyqqbu",
   "type": "text",
   "x": 72,
   "y": 4594,
   "width": 1216,
   "height": 16.25,
   "angle": 0,
   "strokeColor": "#5f3a00",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 219126,
   "version": 1,
   "versionNonce": 843637,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Resilience contract per agent call:  30s timeout  \u00b7  2 retries with exponential backoff (1s, 4s) on 429/5xx  \u00b7  output parsed with Zod, a schema failure is retried once with the validation error appended to the prompt  \u00b7  a second schema failure fails the agent  \u00b7  a failed agent in Wave 1 degrades the pipeline (Strategy is told the input is missing and drops confidence) rather than aborting it  \u00b7  a failed Strategy or Execution agent aborts and persists status FAILED.",
   "fontSize": 13,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "g1o5s7kde7nd4tgsed",
   "originalText": "Resilience contract per agent call:  30s timeout  \u00b7  2 retries with exponential backoff (1s, 4s) on 429/5xx  \u00b7  output parsed with Zod, a schema failure is retried once with the validation error appended to the prompt  \u00b7  a second schema failure fails the agent  \u00b7  a failed agent in Wave 1 degrades the pipeline (Strategy is told the input is missing and drops confidence) rather than aborting it  \u00b7  a failed Strategy or Execution agent aborts and persists status FAILED.",
   "lineHeight": 1.25,
   "baseline": 13
  },
  {
   "id": "m60pe0ms7ufybjaupb",
   "type": "text",
   "x": 60,
   "y": 4752,
   "width": 1200,
   "height": 35.0,
   "angle": 0,
   "strokeColor": "#12233f",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
