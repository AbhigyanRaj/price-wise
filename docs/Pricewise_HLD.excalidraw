  {
   "id": "nz0xousg8819q4i0z7",
   "type": "text",
   "x": 72,
   "y": 3584,
   "width": 1416,
   "height": 81.25,
   "angle": 0,
   "strokeColor": "#5f3a00",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 873867,
   "version": 1,
   "versionNonce": 376866,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Schema decisions worth defending in the interview:\n\u00b7 organizationId is denormalised onto PricingRecommendation and AuditLog even though it is reachable via Product. This lets the hottest queries (the approval queue, the audit trail) filter on a single indexed column with no join \u2014 the tenant guarantee stays cheap.\n\u00b7 AgentRun stores input and output as jsonb rather than typed columns. Agent output shapes differ per agent and will evolve; jsonb keeps the explainability trail complete without a migration per prompt change.\n\u00b7 RefreshToken.replacedById forms a rotation chain. Re-use of an already-rotated token is a theft signal, and the whole chain is revoked in response.\n\u00b7 PriceExecution is separate from PricingRecommendation because one recommendation can be attempted, fail at the platform, roll back, and be retried \u2014 a 1:N history, not a status field.",
   "fontSize": 13,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "c5gjwgqzdxdrxybg8o",
   "originalText": "Schema decisions worth defending in the interview:\n\u00b7 organizationId is denormalised onto PricingRecommendation and AuditLog even though it is reachable via Product. This lets the hottest queries (the approval queue, the audit trail) filter on a single indexed column with no join \u2014 the tenant guarantee stays cheap.\n\u00b7 AgentRun stores input and output as jsonb rather than typed columns. Agent output shapes differ per agent and will evolve; jsonb keeps the explainability trail complete without a migration per prompt change.\n\u00b7 RefreshToken.replacedById forms a rotation chain. Re-use of an already-rotated token is a theft signal, and the whole chain is revoked in response.\n\u00b7 PriceExecution is separate from PricingRecommendation because one recommendation can be attempted, fail at the platform, roll back, and be retried \u2014 a 1:N history, not a status field.",
   "lineHeight": 1.25,
   "baseline": 13
  },
  {
   "id": "5j2rln244ygfuhmdfz",
   "type": "text",
   "x": 60,
   "y": 3792,
   "width": 1200,
   "height": 35.0,
   "angle": 0,
   "strokeColor": "#12233f",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 234511,
   "version": 1,
   "versionNonce": 889093,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "4. AI orchestration \u2014 5-agent pipeline",
   "fontSize": 28,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "4. AI orchestration \u2014 5-agent pipeline",
   "lineHeight": 1.25,
   "baseline": 28
  },
  {
   "id": "38kch78hqpw2d8oivq",
   "type": "text",
   "x": 60,
   "y": 3834,
   "width": 1400,
   "height": 17.5,
   "angle": 0,
   "strokeColor": "#5a6675",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 439890,
   "version": 1,
   "versionNonce": 610273,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Each agent is one Groq call with its own system prompt, its own tool subset, and a strict Zod output schema. Agents never free-text at each other; they exchange validated JSON.",
   "fontSize": 14,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Each agent is one Groq call with its own system prompt, its own tool subset, and a strict Zod output schema. Agents never free-text at each other; they exchange validated JSON.",
   "lineHeight": 1.25,
   "baseline": 14
  },
