# Dependencies
node_modules/

# Build output
dist/
build/

# Prisma 7 generates the client into the source tree rather than node_modules.
# It is build output, regenerated by `prisma generate`, so it is not tracked.
src/generated/

# TypeScript incremental build state. A stale one committed here makes
# `tsc -b` skip type checking on a clean CI or Vercel build.
*.tsbuildinfo

# Environment
.env
.env.*
# .env.example is the documented template every setup depends on, so the
# broad .env.* rule above must not swallow it.
!.env.example
# Allowed through deliberately, for when the split deployment needs it:
# VITE_API_URL is a public build-time constant baked into the JS bundle, not a
# secret, so committing it keeps the Vercel build reproducible instead of
# depending on a dashboard variable that can drift. The file does not exist
# yet; apps/frontend/.env.example documents what goes in it.
!apps/frontend/.env.production

# The assessment brief. Klypup's document, marked Confidential in its footer,
# and this repository is public. Kept on disk, never committed.
assignment.pdf

# Working documents, not deliverables. The kickoff prompt, the Phase 0 spike
# notes and the implementation plan were scaffolding for building this; they
# describe intent rather than what shipped, and ARCHITECTURE.md and
# DECISIONS.md say the same things about the finished system. Kept on disk.
docs/KICKOFF_PROMPT.md
docs/SPIKE_NOTES.md
docs/IMPLEMENTATION_PLAN.md

# Test output
coverage/
playwright-report/
test-results/

# Logs
*.log

# OS
.DS_Store

# Dev-only Groq response cache
.cache/

# Local convenience file. Seeded throwaway credentials, but no reason to ship it.
CREDENTIALS.txt
