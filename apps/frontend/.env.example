# Where the browser sends API calls.
#
# Leave this unset for local development and for the Docker stack. The default
# is the relative path "/api", which Vite proxies to localhost:4000 in dev and
# nginx proxies to the api container in Docker. A relative path keeps the API
# same-origin, which means the auth cookie stays SameSite=Lax and no CORS
# preflight happens at all.
#
# Set it only for a split deployment, where the frontend is on Vercel and the
# API is on Render. Then it must be the API's full origin with no trailing
# slash, the backend's CORS_ORIGIN must name this app's origin exactly, and the
# backend's COOKIE_SECURE must be true: cross-site cookies require
# SameSite=None, and browsers only accept None together with Secure.
#
# VITE_API_URL=https://pricewise-api.onrender.com

# Vite only exposes variables prefixed with VITE_ to client code. Anything
# without that prefix stays server side, which is why no secret belongs in this
# file: everything here ships to the browser in the built bundle.
