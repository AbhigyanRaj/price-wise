# ---- Runtime -------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# ---- Database ------------------------------------------------------------
# Local docker-compose Postgres. In production this is the Supabase pooled URL.
DATABASE_URL=postgresql://pricewise:pricewise@localhost:5432/pricewise
# Unpooled connection, used only by `prisma migrate`. Supabase provides this
# separately; leave unset locally.
DIRECT_URL=

# ---- Auth ----------------------------------------------------------------
# Generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-48-random-bytes-min-32-chars
JWT_REFRESH_SECRET=replace-me-with-a-different-48-random-bytes
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
# Must be true in production (HTTPS only). Parsed with z.stringbool(), so the
# literal string "false" is correctly read as false.
COOKIE_SECURE=false
# Exact frontend origin. No wildcards: credentials mode forbids them.
CORS_ORIGIN=http://localhost:5173

# NOTE: there is deliberately no COOKIE_DOMAIN. *.onrender.com is on the Public
# Suffix List, so browsers reject a cookie Domain attribute on that host. Leaving
# it unset makes the auth cookie host-only, which is the behaviour we want.

# ---- AI ------------------------------------------------------------------
# https://console.groq.com/keys, free tier is sufficient for this project.
GROQ_API_KEY=gsk_replace_me
# Verified available on the free tier, 2026-09-17. Check the console before
# changing: model ids are deprecated without notice.
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_MODEL_STRONG=openai/gpt-oss-120b
AGENT_TIMEOUT_MS=30000
AGENT_MAX_RETRIES=2

# ---- Mock e-commerce platform -------------------------------------------
# Probability that a simulated price push fails, to exercise rollback logic.
# Set to 0 for deterministic E2E runs, 1 to demonstrate rollback.
MOCK_PLATFORM_FAILURE_RATE=0.1
MOCK_PLATFORM_LATENCY_MS=400
